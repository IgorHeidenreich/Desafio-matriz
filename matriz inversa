package primeiro;
import java.util.Scanner;
public class Teste {

	public static void main(String[] args) {
		
			Scanner scanner = new Scanner(System.in);
		int linhas = 0;
		int colunas = 0;
		
		int l = 0;
		int c = 0;
		System.out.println("digite o numero de linhas");
		linhas = scanner.nextInt();
		System.out.println("digite o numero de colunas");
		colunas = scanner.nextInt();
		
	
		
		int[][] notas = new int [linhas][colunas];
		for ( l = 0 ; l< linhas; l++){
			for (c = 0; c < colunas; c++){
				System.out.println(" informe o numero da posição" + (l+1) + " " + (c+1));
				notas[l][c] = scanner.nextInt();
				
			}
				}
		System.out.println("Matriz:");
        for (l = 0; l < linhas; l++) {
            for (c = 0; c < colunas; c++) {
                System.out.print(notas[l][c] + " ");
			}
            System.out.println();
		} 
        	int[][] inversa = new int [colunas][linhas];
        	for ( c = 0 ; c< colunas; c++){
    			for (l = 0; l < linhas; l++) {
    				inversa[c][l] = notas [l][c];
    			}
        	

	}System.out.println("Matriz inversa:");
		for (c = 0; c< colunas; c++) {
			for (l = 0; l < linhas; l++) {
				System.out.print(inversa[c][l] + " ");
			}
			System.out.println();
		}
	}	
}
	
